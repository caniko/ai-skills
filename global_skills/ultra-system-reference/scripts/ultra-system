#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd "$(dirname "$0")" && pwd)
implementation="$script_dir/ultra_system.py"

if command -v python3 >/dev/null 2>&1 && python3 -c 'import sys; raise SystemExit(sys.version_info < (3, 11))'; then
  exec python3 "$implementation" "$@"
fi
if command -v python >/dev/null 2>&1 && python -c 'import sys; raise SystemExit(sys.version_info < (3, 11))'; then
  exec python "$implementation" "$@"
fi
if command -v nix >/dev/null 2>&1; then
  exec nix shell nixpkgs#python3 -c python3 "$implementation" "$@"
fi

printf 'ultra-system requires Python 3.11 or newer; install python3 or use nix shell nixpkgs#python3\n' >&2
exit 127
