#!/usr/bin/env bash
set -euo pipefail

root=${1:-.}
registry=${2:-"$(dirname "$0")/../references/concerns.toml"}

if [[ ! -d "$root" ]]; then
  printf 'missing repository directory: %s\n' "$root" >&2
  exit 2
fi

printf 'repository: %s\n' "$(cd "$root" && pwd)"
printf 'Nix files:\n'
while IFS= read -r file; do
  printf '  %s (%s lines)\n' "$file" "$(wc -l < "$file")"
done < <(find "$root" -type f -name '*.nix' \
  -not -path '*/.git/*' -not -path '*/result*' -not -path '*/target/*' \
  -not -path '*/vendor/*' -not -path '*/node_modules/*' -print | sort)

printf '\nrepository signals:\n'
for signal in flake.nix flake.lock; do
  if [[ -e "$root/$signal" ]]; then printf '  present: %s\n' "$signal"; else printf '  absent: %s\n' "$signal"; fi
done
for signal in nixosConfigurations homeConfigurations packages checks formatter; do
  if rg -q "$signal" "$root" --glob '*.nix' --glob '!result*' 2>/dev/null; then
    printf '  signal: %s\n' "$signal"
  fi
done

printf '\nconcern registry:\n'
awk -F '"' '
  /^name = / { name = $2 }
  /^skill = / { skill = $2 }
  /^stage = / { stage = $2 }
  /^profiles = / { print "  " name " -> " skill " [" stage "] " $0; name=""; skill=""; stage="" }
' "$registry"
