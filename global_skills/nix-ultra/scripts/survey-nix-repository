#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd "$(dirname "$0")" && pwd)
root=${1:-.}
registry=${2:-"$script_dir/../references/concerns.toml"}
sensitivity=${3:-medium}
mode=${4:-compatibility}
mode_approved_by=${5:-}
mode_reason=${6:-}
common="$script_dir/../../ultra-system-reference/scripts/ultra-system"

args=(
  survey
  --root "$root"
  --registry "$registry"
  --sensitivity "$sensitivity"
  --mode "$mode"
  --format text
)
if [[ -n "$mode_approved_by" || -n "$mode_reason" ]]; then
  args+=(--mode-approved-by "$mode_approved_by" --mode-reason "$mode_reason")
fi

exec "$common" "${args[@]}"
